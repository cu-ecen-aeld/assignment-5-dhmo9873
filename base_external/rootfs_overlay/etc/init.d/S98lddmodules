#!/bin/sh

case "$1" in
  start)
    echo "Loading LDD modules..."
    
    # 1. Load scull (uses a helper script or manual insmod)
    # The assignment suggests using scull_load as a reference.
    # We will use the standard path where Buildroot installs modules.
    /usr/bin/scull_load
    
    # 2. Load faulty
    /usr/bin/module_load faulty
    
    # 3. Load hello (personalized module) using modprobe
    # modprobe looks in /lib/modules/$(uname -r)/
    modprobe hello
    ;;
    
  stop)
    echo "Unloading LDD modules..."
    
    # Unload scull
    /usr/bin/scull_unload
    
    # Unload faulty
    /usr/bin/module_unload faulty
    
    # Unload hello
    rmmod hello
    ;;
    
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
esac

exit 0
