#!/bin/sh

case "$1" in
    start)
        echo "Loading LDD modules..."
        # 1. Load the hello module (This is already working for you)
        modprobe hello

        # 2. Load scull binary, THEN run script to create /dev nodes
        modprobe scull
        # We call the script but ignore its attempt to insmod (which will now fail harmlessly)
        /usr/bin/scull_load > /dev/null 2>&1

        # 3. Load faulty binary, THEN run script to create /dev nodes
        modprobe faulty
        /usr/bin/module_load faulty > /dev/null 2>&1
        ;;
    stop)
        echo "Unloading LDD modules..."
        /usr/bin/module_unload faulty
        /usr/bin/scull_unload
        rmmod hello
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac

exit 0
