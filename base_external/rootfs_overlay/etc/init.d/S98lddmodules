#!/bin/sh

case "$1" in
    start)
        echo "Loading LDD modules..."
        /sbin/depmod -a

        # 1. Load hello
        modprobe hello

        # 2. Load and setup scull
        modprobe scull
        # The scull_load script creates nodes, but we need to make sure it finds the major #
        /usr/bin/scull_load

        # 3. Load and setup faulty
        modprobe faulty
        # Manually create the faulty node so it's guaranteed to work
        major=$(awk '$2=="faulty" {print $1}' /proc/devices)
        if [ ! -z "$major" ]; then
            rm -f /dev/faulty
            mknod /dev/faulty c $major 0
            chmod 666 /dev/faulty
            echo "Device /dev/faulty created with major $major"
        fi
        ;;
    stop)
        # Standard cleanup
        rmmod faulty scull hello 2>/dev/null
        rm -f /dev/faulty /dev/scull[0-3]
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
esac
